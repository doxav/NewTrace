{
  "schema_version": "optimizer-discovery-phase0/v1",
  "purpose": "scientific instrument and portable Patrick interface",
  "non_goals": [
    "Phase-1 benchmark",
    "search algorithms",
    "security sandbox",
    "memory architecture"
  ],
  "artifact_contract": {
    "file": "optimizer.py",
    "signature": "propose(history, bounds, seed)",
    "direction": "minimize",
    "history_fields": [
      "x",
      "value"
    ],
    "output": "finite in-bounds point",
    "timeout_s": 2,
    "determinism_repeats": 2
  },
  "validity_rules": [
    "syntax",
    "import",
    "missing_propose",
    "signature",
    "exception",
    "timeout",
    "shape",
    "nonfinite",
    "bounds",
    "nondeterministic",
    "valid"
  ],
  "fixture": {
    "name": "shifted_sphere_2d",
    "bounds": [
      [
        -5,
        5
      ],
      [
        -5,
        5
      ]
    ],
    "shift": [
      1.25,
      -0.75
    ],
    "budget": 8,
    "seeds": [
      0,
      1,
      2
    ],
    "holdout": false,
    "quality_threshold": null
  },
  "live": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-flash-0731",
    "temperature": 0.6,
    "top_p": 1.0,
    "max_tokens": 3000,
    "seed": 17,
    "concurrency": 1,
    "request_timeout_s": 120,
    "requests": [
      "generation_1",
      "generation_2",
      "clean_smoke"
    ],
    "retry_delays_s": [
      2,
      4,
      8
    ],
    "credential_ref": "OPENROUTER_API_KEY"
  },
  "tests": [
    "program_validation",
    "determinism",
    "exact_budget",
    "sanitized_process",
    "menu_evidence",
    "canonical_integration",
    "offline_regression",
    "real_provider"
  ],
  "acceptance_criteria": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "F",
    "G",
    "H",
    "I",
    "J",
    "K",
    "L"
  ],
  "historical_constraints": [
    "H1 refuted",
    "H2 conditional",
    "H3 failed",
    "H5 supported",
    "EXP-12/13 independent",
    "MC-b/d future evidence only"
  ],
  "protocol": "PHASE0_SPEC.md"
}
