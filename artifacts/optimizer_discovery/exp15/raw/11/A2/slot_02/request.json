      "content": "Improve the current optimizer using TRAINING FEEDBACK only.\nCURRENT SOURCE:\nimport random\nimport math\n\ndef propose(history, bounds, seed):\n    \"\"\"Deterministic black-box optimizer using a two-stage strategy:\n    early global exploration and later local refinement.\"\"\"\n    rng = random.Random(seed + len(history))\n    d = len(bounds)\n    lows = [lo for lo, hi in bounds]\n    highs = [hi for lo, hi in bounds]\n\n    def uniform_point():\n        return [rng.uniform(lows[i], highs[i]) for i in range(d)]\n\n    if not history:\n        return uniform_point()\n\n    # Early phase: explicitly explore under-explored regions\n    if len(history) < 8:\n        best_candidate = None\n        best_min_dist = -1.0\n        n_candidates = 50\n        for _ in range(n_candidates):\n            cand = [rng.uniform(lows[i], highs[i]) for i in range(d)]\n            # Compute minimum normalized squared distance to all previous points\n            min_dist = float('inf')\n            for row in history:\n                d2 = 0.0\n                for i in range(d):\n                    span = highs[i] - lows[i]\n                    v = (cand[i] - row['x'][i]) / span if span > 0 else 0.0\n                    d2 += v * v\n                if d2 < min_dist:\n                    min_dist = d2\n            if min_dist > best_min_dist:\n                best_min_dist = min_dist\n                best_candidate = cand\n        return best_candidate\n\n    # Exploitation phase: focus on the best observed point\n    best_row = min(history, key=lambda r: r[\"value\"])\n    best_x = best_row[\"x\"]\n    num = len(history)\n\n    # Strategy proportions\n    p_rand = 0.05          # still allow some exploration\n    p_diff = 0.25         # differential mutation\n    r = rng.random()\n\n    if r < p_rand:\n        return uniform_point()\n\n    if r < p_rand + p_diff:\n        # Differential step: best + F * (x1 - x2)\n        if len(history) < 2:\n            # fallback to perturbation\n            scale = 0.05 * (highs[i] - lows[i]) if i == 0 else 0.0\n            return [max(lows[i], min(highs[i],\n                                     best_x[i] + rng.gauss(0.0, 0.05 * (highs[i] - lows[i]))))\n                    for i in range(d)]\n\n        idx1 = rng.randrange(len(history))\n        idx2 = rng.randrange(len(history) - 1)\n        if idx2 >= idx1:\n            idx2 += 1\n        x1 = history[idx1][\"x\"]\n        x2 = history[idx2][\"x\"]\n        F = 0.2 + rng.random() * 0.6\n        new = [best_x[i] + F * (x1[i] - x2[i]) for i in range(d)]\n        return [max(lows[i], min(highs[i], new[i])) for i in range(d)]\n\n    # Local Gaussian refinement with shrinking search radius\n    scale = 0.1 * (0.75 ** (num - 7))\n    if scale < 0.005:\n        scale = 0.005\n    new = [best_x[i] + rng.gauss(0.0, scale * (highs[i] - lows[i]))\n           for i in range(d)]\n    return [max(lows[i], min(highs[i], new[i])) for i in range(d)]\n\nTRAINING FEEDBACK:\n{\"current\": {\"tasks\": [{\"best_observed_value\": 0.13400006916168414, \"observations\": [{\"value\": 12.519961809168489, \"x\": [2.111290213387358, -4.94981157183487]}, {\"value\": 5.628091883177456, \"x\": [-2.0099566664594946, 4.836775038919519]}, {\"value\": 0.13400006916168414, \"x\": [-0.20160333192803587, 1.5580236403663137]}, {\"value\": 0.14098385635464222, \"x\": [-0.26921165053952123, 1.6093424525660116]}], \"status\": \"valid\", \"valid\": true}, {\"best_observed_value\": 6.736492538691352, \"observations\": [{\"value\": 22.281468583374284, \"x\": [0.4773403266425378, 4.4985714641651775, 4.117786911948549, 1.4901711615766882]}, {\"value\": 37.984811194221365, \"x\": [-4.707829883510978, -1.3280042737326427, -4.523673708264198, 0.6782154161131402]}, {\"value\": 6.73732455260821, \"x\": [-1.1093260500219375, -2.020466116988839, 0.25294293778530125, 1.3395109493834376]}, {\"value\": 6.772594954353715, \"x\": [-1.1361481132434803, -1.9292368293001236, 0.37292042765273214, 1.2