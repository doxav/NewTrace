      "content": "Improve the current optimizer using TRAINING FEEDBACK only.\nCURRENT SOURCE:\nimport random\n\ndef propose(history, bounds, seed):\n    \"\"\"Quadratic surrogate when enough data, else adaptive exploration.\"\"\"\n    def solve_linear(A, b):\n        n = len(b)\n        aug = [row[:] + [b[i]] for i, row in enumerate(A)]\n        for i in range(n):\n            # partial pivoting\n            max_row = i\n            max_abs = abs(aug[i][i])\n            for r in range(i + 1, n):\n                if abs(aug[r][i]) > max_abs:\n                    max_abs = abs(aug[r][i])\n                    max_row = r\n            if max_abs < 1e-12:\n                return None\n            aug[i], aug[max_row] = aug[max_row], aug[i]\n            pivot = aug[i][i]\n            for j in range(i, n + 1):\n                aug[i][j] /= pivot\n            for r in range(n):\n                if r != i:\n                    factor = aug[r][i]\n                    for j in range(i, n + 1):\n                        aug[r][j] -= factor * aug[i][j]\n        return [aug[i][n] for i in range(n)]\n\n    rng = random.Random(seed + len(history))\n    d = len(bounds)\n    if not history:\n        return [rng.uniform(low, high) for low, high in bounds]\n\n    best = min(history, key=lambda row: row[\"value\"])[\"x\"]\n\n    # number of quadratic coefficients\n    p = 1 + d + d * (d + 1) // 2\n\n    # try to fit a quadratic model once we have enough points\n    if len(history) >= p + 2:\n        A = []\n        y = []\n        for row in history:\n            x = row[\"x\"]\n            feats = [1.0] + list(x) + [x[i] * x[j] for i in range(d) for j in range(i, d)]\n            A.append(feats)\n            y.append(row[\"value\"])\n        n = len(A)\n\n        # build normal equations\n        AtA = [[0.0] * p for _ in range(p)]\n        Aty = [0.0] * p\n        for i in range(n):\n            for r in range(p):\n                Aty[r] += A[i][r] * y[i]\n                for c in range(p):\n                    AtA[r][c] += A[i][r] * A[i][c]\n\n        # ridge regularization\n        lam = 1e-6\n        for r in range(p):\n            AtA[r][r] += lam\n\n        w = solve_linear(AtA, Aty)\n        if w is not None:\n            # extract linear and quadratic coefficients\n            b = w[1:1 + d]\n            C = [[0.0] * d for _ in range(d)]\n            idx = 1 + d\n            for i in range(d):\n                for j in range(i, d):\n                    val = w[idx]\n                    if i == j:\n                        C[i][i] = val\n                    else:\n                        C[i][j] = val / 2.0\n                        C[j][i] = val / 2.0\n                    idx += 1\n\n            # stationary point of the quadratic\n            rhs = [-0.5 * bi for bi in b]\n            x_star = solve_linear(C, rhs)\n            if x_star is not None:\n                # clip to bounds and return\n                return [min(max(low, x), high) for x, (low, high) in zip(x_star, bounds)]\n\n    # fallback: adaptive exploration / local refinement\n    t = len(history) / 31.0  # progress toward the 32\u2011evaluation budget\n    p_explore = 0.5 * (1 - t) + 0.05   # decreasing chance to explore globally\n    if rng.random() < p_explore:\n        return [rng.uniform(low, high) for low, high in bounds]\n\n    # local step around the best point, with a larger initial scale\n    scale_factor = 0.3 / (1.0 + t * 4.0) ** 0.5\n    return [max(low, min(high, x + rng.gauss(0.0, scale_factor * (high - low))))\n            for x, (low, high) in zip(best, bounds)]\n\nTRAINING FEEDBACK:\n{\"current\": {\"tasks\": [{\"best_observed_value\": 3.330793823518198e-16, \"observations\": [{\"value\": 12.749228402194758, \"x\": [-3.834604763175199, -3.7545411906678847]}, {\"value\": 16.018717596365843, \"x\": [-5.0, -2.621959321313314]}, {\"value\": 3.343205488096745e-16, \"x\": [-0.37629719578090903, 0.8887940726680063]}, {\"value\": 3.330793823518198e-16, \"x\": [-0.3