      "content": "Improve the current optimizer using TRAINING FEEDBACK only.\nCURRENT SOURCE:\nimport math\nimport random\n\ndef propose(history, bounds, seed):\n    rng = random.Random(seed + len(history))\n    dim = len(bounds)\n    ranges = [high - low for low, high in bounds]\n\n    if not history:\n        return [rng.uniform(low, high) for low, high in bounds]\n\n    # Best observed point\n    best_idx = min(range(len(history)), key=lambda i: history[i][\"value\"])\n    best_x = history[best_idx][\"x\"]\n\n    progress = len(history) / 32.0\n    lam = 0.5 * (1.0 - progress) + 0.01  # exploration weight\n\n    # Generate candidate points: mix of uniform, local around best, local around random history\n    n_candidates = 50\n    candidates = []\n\n    for _ in range(n_candidates):\n        r = rng.random()\n        if r < 0.3:\n            # pure uniform exploration\n            cand = [rng.uniform(low, high) for low, high in bounds]\n        elif r < 0.7:\n            # local around best\n            scale = max(0.01, 0.2 * (1.0 - progress))\n            cand = [best_x[i] + rng.gauss(0, scale * ranges[i]) for i in range(dim)]\n            cand = [min(max(cand[i], bounds[i][0]), bounds[i][1]) for i in range(dim)]\n        else:\n            # local around a random point from history\n            idx = rng.randrange(len(history))\n            p = history[idx][\"x\"]\n            scale = max(0.01, 0.2 * (1.0 - progress)) * 2\n            cand = [p[i] + rng.gauss(0, scale * ranges[i]) for i in range(dim)]\n            cand = [min(max(cand[i], bounds[i][0]), bounds[i][1]) for i in range(dim)]\n        candidates.append(cand)\n\n    # Normalize history points for distance computations\n    norm_history = []\n    for obs in history:\n        norm_x = [(obs[\"x\"][i] - bounds[i][0]) / ranges[i] for i in range(dim)]\n        norm_history.append((norm_x, obs[\"value\"]))\n\n    k = min(len(history), 5)  # number of neighbors for surrogate\n\n    best_score = float('inf')\n    best_candidate = None\n\n    for cand in candidates:\n        norm_cand = [(cand[i] - bounds[i][0]) / ranges[i] for i in range(dim)]\n        # distances to all history points\n        dists = []\n        for norm_x, val in norm_history:\n            d = math.sqrt(sum((norm_cand[i] - norm_x[i]) ** 2 for i in range(dim)))\n            dists.append((d, val))\n        dists.sort(key=lambda t: t[0])\n        knn = dists[:k]\n\n        if knn[0][0] < 1e-12:\n            pred = knn[0][1]\n            min_dist = 0.0\n        else:\n            weights = [1.0 / (d + 1e-9) for d, _ in knn]\n            total_w = sum(weights)\n            pred = sum(w * v for w, (_, v) in zip(weights, knn)) / total_w\n            min_dist = knn[0][0]\n\n        score = pred + lam * min_dist\n        if score < best_score:\n            best_score = score\n            best_candidate = cand\n\n    return best_candidate\n\nTRAINING FEEDBACK:\n{\"current\": {\"tasks\": [{\"best_observed_value\": 0.0008868263747649107, \"observations\": [{\"value\": 1.6687834863051978, \"x\": [1.1935682795631921, 1.7445933311076072]}, {\"value\": 0.8134695294902444, \"x\": [0.67226043653802, 1.6593798338958408]}, {\"value\": 0.00231096076090978, \"x\": [-0.37588072820654345, 0.9833822368667378]}, {\"value\": 0.0019743945731727523, \"x\": [-0.39190617011928686, 0.9729243846430268]}], \"status\": \"valid\", \"valid\": true}, {\"best_observed_value\": 0.0290288472493889, \"observations\": [{\"value\": 11.300482493663596, \"x\": [-1.2708597554917986, -0.3073861360368362, 0.9499135629780753, 3.142801436194734]}, {\"value\": 17.84145823050097, \"x\": [0.3884845560813883, 0.3436732416034537, 1.2846500804192902, 4.008577369142718]}, {\"value\": 0.05376792360226914, \"x\": [-0.2927471845493367, 0.8653862005357476, -1.238674388100877, 1.4308321044200205]}, {\"value\": 0.0290288472493889, \"x\": [-0.3265508312260569, 0.9496596201408266, -1.2543903624721209, 1.3207736784829436]}], \"status\": \"valid\", \"valid\": true}