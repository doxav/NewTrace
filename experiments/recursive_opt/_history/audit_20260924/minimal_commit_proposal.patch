@@ -754,6 +754,68 @@ def test_15_automatic_exact_model_preflight() -> None:
     ]
 
 
+@pytest.mark.parametrize("preference", ["price", "latency", "throughput"])
+def test_openrouter_sort_survives_normalization(preference: str) -> None:
+    """Preserve the native routing preference without changing model identity."""
+    raw = _spec()
+    raw["llm_profiles"] = {
+        "main": {
+            "provider": "openrouter",
+            "model": "deepseek/deepseek-v4-flash-0731",
+            "request_params": {"extra_body": {"provider": {"sort": preference}}},
+        }
+    }
+    normalized = S.normalize_spec(raw)
+    profile = normalized["llm_profiles"]["main"]
+    assert profile["request_params"]["extra_body"]["provider"]["sort"] == preference
+    assert profile["resolved_model"] == "openrouter/deepseek/deepseek-v4-flash-0731"
+    raw["llm_profiles"]["main"]["request_params"] = {}
+    assert normalized["fingerprint"] != S.normalize_spec(raw)["fingerprint"]
+
+
+@pytest.mark.parametrize(
+    "provider,request_params",
+    [
+        ("openai", {"extra_body": {"provider": {"sort": "price"}}}),
+        ("openrouter", {"provider": {"sort": "price"}}),
+        ("openrouter", {"extra_body": {"provider": {"sort": "unknown"}}}),
+        ("openrouter", {"extra_body": {"provider": {"sort": ["price"]}}}),
+        ("openrouter", {"extra_body": {"provider": {"sort": None}}}),
+        ("openrouter", {"extra_body": {"provider": {}}}),
+        ("openrouter", {"extra_body": {"provider": "price"}}),
+        ("openrouter", {"extra_body": {"provider": {"sort": "price", "order": []}}}),
+        (
+            "openrouter",
+            {"extra_body": {"provider": {"sort": "price", "api_key": "placeholder"}}},
+        ),
+        ("openrouter", {"extra_body": {"model": "different"}}),
+        (
+            "openrouter",
+            {
+                "extra_body": {
+                    "provider": {"sort": "price"},
+                    "base_url": "https://invalid.test",
+                }
+            },
+        ),
+    ],
+)
+def test_openrouter_sort_rejects_other_controls(
+    provider: str, request_params: dict[str, Any]
+) -> None:
+    """Reject malformed routing and identity overrides even beside a valid sort."""
+    raw = _spec()
+    raw["llm_profiles"] = {
+        "main": {
+            "provider": provider,
+            "model": "exact",
+            "request_params": request_params,
+        }
+    }
+    with pytest.raises(ValueError):
+        S.normalize_spec(raw)
+
+
