experiments/**/*.json
experiments/**/*.jsonl
# ...but the curated _history/ archive is tracked project structure, not byproduct: these
# result files are the evidence trail behind _history/navigation/RESEARCH_LOG.md. Only the
# top level is exempt -- per-run */artifacts.jsonl and */events.jsonl stay untracked.
!experiments/recursive_opt/_history/probe_2026/*.json
# EXP22 run configs are provenance, not byproduct: they record the exact spec each run
# executed. EXP22/configs is a symlink to evox/configs, which this rule had left empty.
!experiments/recursive_opt/EXP22/evox/configs/**/*.json
# Control-plane test fixtures and the provenance seal. Tracked unit tests read these, so they
# must exist on a fresh checkout (CI); the 2026-09-30 move under experiments/ had untracked them.
!experiments/recursive_opt/_shared/control_plane_v2/**/*.json
# Per-experiment navigation metadata (status line, linked from each README and the index).
!experiments/recursive_opt/EXP*/manifest.json
!experiments/recursive_opt/EXP27/results/mechanisms.json
!experiments/recursive_opt/EXP27/results/ablation/*.jsonl
!experiments/recursive_opt/EXP27/results/factorial/*.jsonl
!experiments/recursive_opt/EXP27/results/factorial/design.json
!experiments/recursive_opt/EXP27/results/strategy_timeline.json
!experiments/recursive_opt/EXP27/results/instruction_yield.json
!experiments/recursive_opt/EXP27/results/learning_curves.json
!experiments/recursive_opt/EXP27/results/partD_*/analysis.json
